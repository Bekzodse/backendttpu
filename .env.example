# =============================================================================
# TTPU "Raqamli Inventar" — Docker Compose Environment Configuration
# Copy to .env to override defaults: cp .env.example .env
# =============================================================================

# --- Backend Application ---
SERVER_PORT=8080
JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -Duser.timezone=UTC -Dfile.encoding=UTF-8

# --- PostgreSQL 16 Database ---
DB_NAME=ttpu_inventory
DB_USERNAME=ttpu
DB_PASSWORD=ttpu_secret
DB_PORT=5432
DB_POOL_MAX_SIZE=30
DB_POOL_MIN_IDLE=5

# --- Redis 7 ---
REDIS_PORT=6379

# --- MinIO S3-Compatible Object Storage ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Mail / Notifications ---
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_HEALTH_ENABLED=false

# --- Prism Mock Server (OpenAPI Mocking) ---
PRISM_PORT=4010

# --- Observability & Monitoring (Prometheus & Grafana) ---
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin_secret

